# ── Frontend env (скопируй в .env и заполни) ──
VITE_API_URL=http://localhost:5000/api/v1

# Cloudinary — unsigned-загрузка с фронта
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Мониторинг ошибок Sentry (пусто = выключено)
VITE_SENTRY_DSN=

# ── Paddle (подписки) ──
# production — боевой кабинет (принимает реальные деньги), sandbox — тестовый
VITE_PADDLE_ENV=production
# Client-side token: Developer tools → Authentication → Client-side tokens
# В production он начинается с live_, в sandbox — с test_. Окружение и токен должны совпадать!
VITE_PADDLE_CLIENT_TOKEN=
# Price ID трёх платных тарифов — ТЕ ЖЕ значения, что в PADDLE_PRICE_* на бэкенде
VITE_PADDLE_PRICE_BASIC=
VITE_PADDLE_PRICE_PRO=
VITE_PADDLE_PRICE_SCHOOL=
