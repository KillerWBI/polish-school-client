{
  // Конфиг деплоя в Cloudflare Workers. До него в репозитории не было ничего, и
  // `npx wrangler versions upload` падал с «Missing entry-point to Worker script or
  // to assets directory»: сборка проходила, а выкладывать было нечего.
  //
  // name обязан совпадать с уже существующим сервисом, иначе создастся новый воркер,
  // а домен продолжит смотреть на старый. Имя взято из адреса сборки в панели:
  // dash.cloudflare.com/.../workers/services/view/polish-school-client/production/builds/...
  "name": "polish-school-client",
  "compatibility_date": "2026-08-10",

  "assets": {
    // Сюда Vite кладёт результат (vite.config.js, по умолчанию dist)
    "directory": "./dist",

    // Приложение — SPA на react-router: прямой заход на /dashboard или /help должен
    // отдавать index.html, а не 404. Прод уже так себя ведёт — фиксируем это в коде,
    // чтобы поведение не зависело от настроек в панели.
    "not_found_handling": "single-page-application"
  }
}
